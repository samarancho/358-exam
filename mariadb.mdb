-- MariaDB dump for EX358 practice (Q16-Q18)
-- Restore into an existing database:  mysql -u root -p Contacts < mariadb.mdb
-- The dump has no CREATE DATABASE / USE, like the exam file.

/*!40101 SET NAMES utf8mb4 */;

--
-- Table structure for table `user_logon`
--

DROP TABLE IF EXISTS `user_logon`;
CREATE TABLE `user_logon` (
  `UserID` int(11) NOT NULL,
  `FirstName` varchar(50) NOT NULL,
  `LastName` varchar(50) NOT NULL,
  `Username` varchar(50) NOT NULL,
  `Password` varchar(50) NOT NULL,
  PRIMARY KEY (`UserID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

